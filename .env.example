# Copy this file to .env (same folder) and fill in the first three lines.
DISCORD_TOKEN=paste-your-bot-token-here
# Right-click your server icon > Copy Server ID (needs Developer Mode on in Discord settings > Advanced)
GUILD_ID=
# Right-click the channel for the daily price post > Copy Channel ID
CHANNEL_ID=
# Optional
DASHBOARD_URL=https://siddly-lab.github.io/tcg-bot/
REFRESH_MINUTES=30
